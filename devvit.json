{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "aurameter",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Open aurameter",
        "description": "Open the aurameter mod dashboard for this subreddit.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/open-dashboard"
      },
      {
        "label": "Check vibe",
        "description": "Score this post on demand and show the result.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/check-vibe"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onPostDelete": "/internal/triggers/on-post-delete",
    "onCommentDelete": "/internal/triggers/on-comment-delete"
  },
  "scheduler": {
    "tasks": {
      "dailyRollup": {
        "cron": "0 7 * * *",
        "endpoint": "/internal/jobs/daily-rollup"
      }
    }
  },
  "customPost": {
    "height": "tall",
    "endpoint": "/internal/custom-post"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "dev": {
    "subreddit": "aurameter_dev"
  }
}
